FROM node:20-bookworm-slim

# Base Debian (non Alpine): dsniff/iptables non sono disponibili per aarch64 su Alpine,
# mentre su Debian (bookworm) sono pacchetti apt stabili e multi-arch (ARM incluso, es. Raspberry Pi).
#
# Strumenti di rete usati dallo scanner (ping, arp, netstat) + runtime libpcap per la cattura pacchetti
# + dsniff (arpspoof) e iptables per il Metodo 2 (ARP Redirection / MITM, vedi scripts/arp_redirect.sh)
# + procps (sysctl, usato dallo script per abilitare/disabilitare l'IP forwarding)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      iputils-ping net-tools iproute2 libpcap0.8 dsniff iptables procps bash ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dipendenze native del backend: `cap` (binding libpcap) e `maxmind` (reader GeoLite2).
# I tool di build (build-essential, libpcap-dev, python3) servono solo a compilare
# `cap` e vengono rimossi subito dopo per tenere l'immagine leggera.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpcap-dev python3 \
 && npm install --no-save --no-package-lock cap@^0.2.1 maxmind@^5.0.6 \
 && apt-get purge -y --auto-remove build-essential libpcap-dev python3 \
 && rm -rf /var/lib/apt/lists/*

COPY server.mjs mock-api.mjs ./
COPY lib ./lib
COPY data ./data
COPY agent ./agent
COPY scripts ./scripts
RUN chmod +x ./scripts/*.sh 2>/dev/null || true
# oui-db.json opzionale: montalo o genera con "npm run oui" e copialo qui

EXPOSE 8000
CMD ["node", "server.mjs"]
